# Hackathon 后端配置文件示例
# 复制此文件为 config.yaml 并修改相应配置

# 数据库配置
database:
  host: localhost
  port: "3306"
  user: root
  password: password
  name: hackathon_db
  # 表结构已就绪时设为 true 可跳过启动时的自动迁移，加快启动（也可用环境变量 SKIP_AUTO_MIGRATE=true）
  # skip_auto_migrate: false

# JWT配置
jwt:
  secret: your-secret-key-change-in-production  # 生产环境请使用强随机字符串
  expire_hours: 24

# 服务器配置
server:
  port: "8000"
  mode: debug  # debug/release/test

# CORS配置
cors:
  allow_origins:
    - http://localhost:3000
    - http://localhost:3001

# Solana 活动发布与赞助商金库（发布/赞助申请由前端 Phantom 钱包授权，无需配置 authority_key）
# 赞助商审核期限在链上 initialize_sponsor_config 时设置，默认建议 3 小时（10800 秒）
# 主办方审核赞助申请时需用钱包签名，sponsor_admin_wallet 须与链上 initialize_sponsor_config 的 admin_wallet 一致（审核通过时收款地址）
# solana:
#   program_id: "DtuGwFvSDnQyLamC5Lkf8hxvmU1VNYJxSNuss4qLb8cg"
#   rpc_url: "http://127.0.0.1:8899"   # 本地网络
#   sponsor_admin_wallet: "DnwSNxJfQYHhtFboSDbqx1szVWgdf72AC1mayVA2AA4k"  # 或环境变量 SOLANA_SPONSOR_ADMIN_WALLET

