# Hackathon 后端配置文件示例
# 复制此文件为 config.yaml 并修改相应配置

# 数据库配置
database:
  host: localhost
  port: "3306"
  user: root
  password: password
  name: hackathon_db

# JWT配置
jwt:
  secret: your-secret-key-change-in-production  # 生产环境请使用强随机字符串
  expire_hours: 24

# 服务器配置
server:
  port: "8000"
  mode: debug  # debug/release/test

# CORS配置
cors:
  allow_origins:
    - http://localhost:3000
    - http://localhost:3001

# Solana 本地测试链（活动/签到/投票/赞助商链上功能）
# program_id 需与 solana/target/deploy 部署的程序 ID 一致（见 Anchor.toml）
solana:
  rpc_url: "http://localhost:8899"
  program_id: "2BE9YFPLME8in2tsSeTY7CpKg7btYubQW5BFG9vdAMYX"

